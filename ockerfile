FROM mcr.microsoft.com/dotnet/nightly/sdk:10.0-alpine3.24-amd64 AS build

WORKDIR /src
COPY ./src/NopCommerce.sln ./
COPY ./src/ ./

#install dependencies

RUN dotnet restore ./NopCommerce.sln

#build project

RUN dotnet build ./NopCommerce.sln -c Release

#publish project to a folder

WORKDIR /src/Presentation/Nop.Web/

RUN dotnet publish Nop.Web.csproj -c Release -o /app/publish

#ru-time stage

FROM mcr.microsoft.com/dotnet/framework/runtime:4.8-20260512-windowsservercore-ltsc2016 

WORKDIR /app

COPY --from=build /app/publish  .

EXPOSE 8080

CMD ["dotnet", "Nop.Web"]